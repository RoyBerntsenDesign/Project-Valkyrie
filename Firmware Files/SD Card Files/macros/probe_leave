echo "probe_leave"
var Xdock_center = 36
var Ydock_center = -17.5

M564 S0                                           ;  S1 = limit movement within axis boundaries, S0 = allow movement outside boundaries
if sensors.probes[0].value[0]!=1000               ; if sensor is value other than 1000 do this
	G1 X{move.axes[0].min + var.Xdock_center} F18000 ; X position of flint zone
	G1 Y{move.axes[1].min + var.Ydock_center} F18000 ; Y position of flint zone  
	G1 X 70 F5000
	G1 Y30 F18000
M564 S1