; simple sequence to sett Z offset
var avg = 0                            ; configure variable: avg
var k0_offset = 7                      ; set offset value from Y minima to probe bed probe on anvil
var k1_offset = 1                      ; set offset value from Y minima to probe tool probe with nozzle

; step 1 - pick up probe if not attached and probe bed
if sensors.probes[0].value[0] = 1000   ; check probe status
    M98 P"/macros/probe_get"           ; pickup probe if not attached

G31 K0 Z0                              ; clear K0 offset
G31 K1 Z0                              ; clear K1 offset

M98 P"/macros/probe_center"            ; make sure probe is on center bed
G30 K0                                 ; probe bed with a Single Z-Probe

; step 2 - probe 3 times on alvin and return offset value.
G1 F30000                              ; set travel speed
G1 X{move.axes[0].max/2}               ; move to center x axis
G1 Y{move.axes[1].min + var.k0_offset} ; move bed probe to anvil

G30 K0 P0 Z-99999
set var.avg = sensors.probes[0].lastStopHeight 
G30 K0 P1 Z-99999
set var.avg = var.avg + sensors.probes[0].lastStopHeight 
G30 K0 P2 Z-99999 S-1
set var.avg = var.avg + sensors.probes[0].lastStopHeight 
echo var.avg/3, "avg / 3"

G31 K0 Z{var.avg/3}                    ; set Z offset
G31 K1 Z{var.avg/3}                    ; set Z offset

echo sensors.probes[0].triggerHeight, "K0"
echo sensors.probes[1].triggerHeight, "K1"

G1 X165 Y150 Z10                       ; Move toolhead to center bed and bed down

; step 3 - leave bed probe
M98 P"/macros/probe_leave"
; step 4 - clean nozzle
M98 P"/macros/nozzle_brush"            ; brush nozzle

; step 5 - probe nozzle
G1 F18000 X165 Y-33                    ; move nozzle to probe position
G30 K1

M400
G1 Z25 F1500                           ; Move head to center and bed down to Z25
M98 P"/macros/nozzle_center"           ; move tool to center