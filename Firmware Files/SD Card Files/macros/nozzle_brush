; called to brush the nozzle

G90                                               ; use absolute coordinates

var Xbucket_position = (move.axes[0].max / 2) + 80 ; bucket position from bed center on X
var Ybucket_position = move.axes[1].min + 1         ; brush position near Y minimum
var Xbrush_distance = 45                            ; brushing travel distance
var number_brush = 10                               ; number of brush cycles
var speed1 = 30000                                  ; positioning speed
var speed2 = 12000                                  ; brushing speed

;~~~~~~~~~~~ do not alter anything below this line ~~~~~~~~~~~~~~~

if sensors.probes[0].value[0] == 0                 ; 0 = probe attached
    echo "Probe needs dropping off"
    M98 P"/macros/probe_leave"

G1 F{var.speed1}
G1 Y{var.Ybucket_position}                          ; move to brush Y position
G1 X{var.Xbucket_position}                          ; move to brush X position
M400                                                ; wait until positioning moves are complete

G91                                                ; use relative coordinates

while true
    if iterations == var.number_brush
        break

    G1 F{var.speed2}
    G1 X{var.Xbrush_distance}                       ; move across brush
    G1 X{-var.Xbrush_distance}                      ; move back across brush

G90                                                ; return to absolute coordinates